#!/usr/bin/haserl --upload-limit=2097152 --upload-dir=/tmp
<%
# Contelia
# Copyright (C) 2025-2026  Mathieu Schroeter <mathieu@schroetersa.ch>
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <http://www.gnu.org/licenses/>.

# Configuration
CONTELIA_DIR="/var/lib/contelia"
MAX_ZIP_SIZE=2147483648  # 2048 MB

mkdir -p "$CONTELIA_DIR"

is_valid_folder_name() {
  echo "$1" | grep -qE '^[a-zA-Z0-9._-]+$'
}

# Zip download on the fly
if [ -n "$FORM_download" ]; then
  folder_name="$FORM_download"
  folder_path="$CONTELIA_DIR/$folder_name"

  if is_valid_folder_name "$folder_name" && [ -d "$folder_path" ]; then
    real_base=$(cd "$CONTELIA_DIR" && pwd)
    real_path=$(cd "$folder_path" 2>/dev/null && pwd)

    if [ -n "$real_path" ] && echo "$real_path" | grep -q "^$real_base/"; then
      echo "Content-Type: application/zip"
      echo "Content-Disposition: attachment; filename=\"${folder_name}.zip\""
      echo ""
      # Compress and send to the stdout
      (cd "$CONTELIA_DIR" && zip -x \*.factory_disabled -q -r - "$folder_name")
      exit 0
    fi
  fi
fi

echo "Content-Type: text/html"
echo ""

format_size() {
  local size=$1
  if [ $size -lt 1024 ]; then
    echo "${size}B"
  elif  [ $size -lt 1048576 ]; then
    echo "$((size / 1024))KB"
  else
    echo "$((size / 1048576))MB"
  fi
}

get_story_title() {
  jq -r '.title // empty' "$1/story.json" 2>/dev/null
}

get_story_description() {
  jq -r '.description // empty | gsub("\n"; "<br/>")' "$1/story.json" 2>/dev/null
}

has_thumbnail() {
  [ -f "$1/thumbnail.png" ] && echo "true" || echo "false"
}

is_disabled() {
  [ -f "$1/.factory_disabled" ] && echo "true" || echo "false"
}

# is in CONTELIA_DIR
is_path_safe() {
  local target_path="$1"
  local real_base=$(cd "$CONTELIA_DIR" && pwd)
  local real_target=$(cd "$target_path" 2>/dev/null && pwd)

  if [ -z "$real_target" ] || [ "$real_target" = "$real_base" ]; then
    return 1
  fi

  echo "$real_target" | grep -q "^$real_base/"
}

process_archive_upload() {
  if [ -z "$FORM_archive" ] || [ ! -f "$FORM_archive" ]; then
    return
  fi

  archive_name=$(echo "$FORM_archive_name" | sed 's/[^a-zA-Z0-9._-]/_/g')
  folder_name=$(echo "$archive_name" | sed 's/\.[^.]*$//')

  if ! is_valid_folder_name "$folder_name"; then
    MSG_TYPE="error"
    MSG_TEXT="✗ Nom d'histoire invalide"
    rm -f "$FORM_archive"
    return
  fi

  dest_dir="$CONTELIA_DIR/$folder_name"

  # Check the parent path
  real_base=$(cd "$CONTELIA_DIR" && pwd)
  parent_dir=$(dirname "$dest_dir")
  real_parent=$(cd "$parent_dir" 2>/dev/null && pwd)

  if [ "$real_parent" != "$real_base" ]; then
    MSG_TYPE="error"
    MSG_TEXT="✗ Chemin invalide"
    rm -f "$FORM_archive"
    return
  fi

  if [ -d "$dest_dir" ]; then
    MSG_TYPE="error"
    MSG_TEXT="✗ L'histoire '$folder_name' existe déjà"
    rm -f "$FORM_archive"
    return
  fi

  case "$archive_name" in
    *.zip)
      ;;
    *)
      MSG_TYPE="error"
      MSG_TEXT="✗ Seules les histoires au format ZIP sont supportées"
      rm -f "$FORM_archive"
      return
      ;;
  esac

  mkdir -p "$dest_dir"
  error_log=$(unzip -q "$FORM_archive" -d "$dest_dir" 2>&1)

  if [ $? -ne 0 ]; then
    rm -rf "$dest_dir"
    MSG_TYPE="error"
    MSG_TEXT="✗ Erreur lors de la décompression: $error_log"
    logger -t contelia "Extract error: $archive_name - $error_log"
    rm -f "$FORM_archive"
    return
  fi

  sync

  # Check if there is only one root folder
  root_items=$(find "$dest_dir" -mindepth 1 -maxdepth 1 | wc -l)
  if [ $root_items -eq 1 ]; then
    first_item=$(find "$dest_dir" -mindepth 1 -maxdepth 1)
    if [ -d "$first_item" ]; then
      # Only one folder, move its content
      temp_dir="${dest_dir}_temp"
      mv "$first_item" "$temp_dir"
      rm -rf "$dest_dir"
      mv "$temp_dir" "$dest_dir"
      logger -t contelia "Squashed archive: $archive_name"
    fi
  fi

  MSG_TYPE="success"
  MSG_TEXT="✓ Histoire '$archive_name' chargée"
  logger -t contelia "Upload OK: $archive_name -> $folder_name"
  rm -f "$FORM_archive"
}

process_batch_actions() {
  if [ -z "$FORM_batch_actions" ]; then
    return
  fi

  # Parse JSON actions
  actions_count=0
  errors_count=0

  echo "$FORM_batch_actions" | jq -c '.[]' 2>/dev/null | while read -r action; do
    action_type=$(echo "$action" | jq -r '.type')
    folder_name=$(echo "$action" | jq -r '.folder')

    if echo "$folder_name" | grep -qE '(/|\.\.)'; then
      errors_count=$((errors_count + 1))
      continue
    fi

    folder_path="$CONTELIA_DIR/$folder_name"
    real_base=$(cd "$CONTELIA_DIR" && pwd)
    real_path=$(cd "$folder_path" 2>/dev/null && pwd)

    if [ -z "$real_path" ] || [ "$real_path" = "$real_base" ]; then
      errors_count=$((errors_count + 1))
      continue
    fi

    if ! echo "$real_path" | grep -q "^$real_base/"; then
      errors_count=$((errors_count + 1))
      continue
    fi

    case "$action_type" in
      "delete")
        rm -rf "$folder_path" 2>/dev/null
        if [ $? -eq 0 ]; then
          actions_count=$((actions_count + 1))
          logger -t contelia "Batch delete OK: $folder_name"
        else
          errors_count=$((errors_count + 1))
        fi
        ;;
      "enable")
        rm -f "$folder_path/.factory_disabled" 2>/dev/null
        if [ $? -eq 0 ]; then
          actions_count=$((actions_count + 1))
          logger -t contelia "Batch enable OK: $folder_name"
        else
          errors_count=$((errors_count + 1))
        fi
        ;;
      "disable")
        touch "$folder_path/.factory_disabled" 2>/dev/null
        if [ $? -eq 0 ]; then
          actions_count=$((actions_count + 1))
          logger -t contelia "Batch disable OK: $folder_name"
        else
          errors_count=$((errors_count + 1))
        fi
        ;;
    esac
  done

  if [ $actions_count -gt 0 ]; then
    MSG_TYPE="success"
    MSG_TEXT="✓ $actions_count modification(s) appliquée(s)"
    if [ $errors_count -gt 0 ]; then
      MSG_TEXT="$MSG_TEXT ($errors_count erreur(s))"
    fi
  elif [ $errors_count -gt 0 ]; then
    MSG_TYPE="error"
    MSG_TEXT="✗ $errors_count erreur(s) lors de l'application"
  fi
}

MSG_TYPE=""
MSG_TEXT=""

process_archive_upload
process_batch_actions

folder_count=$(find "$CONTELIA_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
total_size=$(du -sb "$CONTELIA_DIR" 2>/dev/null | awk '{print $1}')
%>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <script>
    if (/android/i.test(navigator.userAgent)) {
      window.location.href = 'intent://${window.location.host}${window.location.pathname}#Intent;scheme=http;end';
    }
  </script>
  <title>Gestionnaire d'histoires Contelia</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>📦 Gestionnaire d'histoires Contelia</h1>

    <div class="stats">
      <div class="stat-item">
        <span>📚</span>
        <span><strong><%= $folder_count %></strong> histoire(s)</span>
      </div>
      <div class="stat-item">
        <span>💾</span>
        <span><strong><% format_size $total_size %></strong> utilisé</span>
      </div>
    </div>

    <% if [ -n "$MSG_TEXT" ]; then %>
      <div class="message <%= $MSG_TYPE %>">
        <%= $MSG_TEXT %>
      </div>
    <% fi %>

    <div class="upload-section">
      <h2>📤 Déployer une histoire</h2>
      <form method="post" enctype="multipart/form-data" class="upload-form" id="uploadForm">
        <input type="file" name="archive" accept=".zip" required id="fileInput">
        <button type="submit" id="submitBtn">Charger</button>
      </form>
      <div class="upload-progress" id="uploadProgress">
        <div class="progress-bar-container">
          <div class="progress-bar-fill" id="progressBar"></div>
        </div>
        <div class="progress-text" id="progressText">Préparation...</div>
      </div>
      <div class="info-text">
        <strong>Format :</strong> ZIP uniquement<br>
        <strong>Taille max :</strong> <% format_size $MAX_ZIP_SIZE %><br>
      </div>
    </div>

    <h2 class="section-title">
      <span>📚 Histoires déployées</span>
      <span class="pending-changes" id="pendingCount" style="display: none;">0 modification(s) en attente</span>
    </h2>

    <% if [ $folder_count -eq 0 ]; then %>
      <div class="empty">
        Aucune histoire déployée<br>
        Charger une histoire au format ZIP pour commencer.
      </div>
    <% else %>
      <div class="book-list" id="bookList">
        <% find "$CONTELIA_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort | while read -r folder_path; do
          folder_name=$(basename "$folder_path")
          size=$(du -sb "$folder_path" 2>/dev/null | awk '{print $1}')
          story_title=$(get_story_title "$folder_path")
          [ -z "$story_title" ] && story_title="$folder_name"
          story_description=$(get_story_description "$folder_path")
          has_thumb=$(has_thumbnail "$folder_path")
          is_disabled_flag=$(is_disabled "$folder_path")
        %>
          <div class="book-card<% [ "$is_disabled_flag" = "true" ] && echo " disabled" %>" data-folder="<%= $folder_name %>" data-disabled="<%= $is_disabled_flag %>">
            <% if [ "$has_thumb" = "true" ]; then %>
              <img src="/contelia/<%= $folder_name %>/thumbnail.png" alt="Miniature" class="thumbnail">
            <% else %>
              <div class="book-placeholder">📖</div>
            <% fi %>

            <div class="book-content">
              <div class="book-info">
                <div class="book-title">
                  <span class="title-text"><%= $story_title %></span>
                  <% if [ "$is_disabled_flag" = "true" ]; then %>
                    <span class="status-badge">DÉSACTIVÉ</span>
                  <% fi %>
                </div>
                <% if [ -n "$story_description" ]; then %>
                  <div class="book-description"><%= $story_description %></div>
                <% fi %>
                <div class="book-size"><% format_size $size %></div>
              </div>

              <div class="book-actions">
                <a href="?download=<%= $folder_name %>" class="download-btn" target="_blank">⬇️ Télécharger</a>
                <% if [ "$is_disabled_flag" = "true" ]; then %>
                  <button type="button" class="toggle disabled" onclick="toggleStory(this, '<%= $folder_name %>')">✔ Activer</button>
                <% else %>
                  <button type="button" class="toggle" onclick="toggleStory(this, '<%= $folder_name %>')">💤 Désactiver</button>
                <% fi %>
                <button type="button" class="delete" onclick="deleteStory(this, '<%= $folder_name %>', '<%= $story_title %>')">🔥 Supprimer</button>
              </div>
            </div>
          </div>
        <% done %>
      </div>

      <form method="post" id="batchForm">
        <input type="hidden" name="batch_actions" id="batchActions">
        <button type="submit" class="apply" id="applyBtn">✓ Appliquer les modifications</button>
      </form>
    <% fi %>
  </div>

  <script>
  const pendingActions = new Map();

  function updateUI() {
    const count = pendingActions.size;
    const applyBtn = document.getElementById('applyBtn');
    const pendingCount = document.getElementById('pendingCount');

    if (count > 0) {
      applyBtn.classList.add('visible');
      pendingCount.style.display = 'block';
      pendingCount.textContent = count + ' modification(s) en attente';
    } else {
      applyBtn.classList.remove('visible');
      pendingCount.style.display = 'none';
    }
  }

  function toggleStory(btn, folderName) {
    const card = btn.closest('.book-card');
    const isCurrentlyDisabled = card.dataset.disabled === 'true';
    const currentAction = pendingActions.get(folderName);

    if (currentAction) {
      pendingActions.delete(folderName);
      card.classList.remove('pending-enable', 'pending-disable', 'pending-delete');

      const pendingBadge = card.querySelector('.pending-badge');
      if (pendingBadge) {
        pendingBadge.remove();
      }
    } else {
      const action = isCurrentlyDisabled ? 'enable' : 'disable';
      pendingActions.set(folderName, { type: action, folder: folderName });

      if (action === 'enable') {
        card.classList.add('pending-enable');
        card.querySelector('.book-title').innerHTML += '<span class="pending-badge">→ ACTIVATION</span>';
      } else {
        card.classList.add('pending-disable');
        card.querySelector('.book-title').innerHTML += '<span class="pending-badge">→ DÉSACTIVATION</span>';
      }
    }

    updateUI();
  }

  function deleteStory(btn, folderName, storyTitle) {
    const card = btn.closest('.book-card');
    const currentAction = pendingActions.get(folderName);

    if (currentAction) {
      pendingActions.delete(folderName);
      card.classList.remove('pending-enable', 'pending-disable', 'pending-delete');

      const pendingBadge = card.querySelector('.pending-badge');
      if (pendingBadge) {
        pendingBadge.remove();
      }
    } else {
      pendingActions.set(folderName, { type: 'delete', folder: folderName });
      card.classList.add('pending-delete');

      const existingBadge = card.querySelector('.pending-badge');
      if (existingBadge) {
        existingBadge.remove();
      }
      card.querySelector('.book-title').innerHTML += '<span class="pending-badge">→ SUPPRESSION</span>';
    }

    updateUI();
  }

  // Handle form submission
  document.getElementById('batchForm').addEventListener('submit', function(e) {
    if (pendingActions.size === 0) {
      e.preventDefault();
      return;
    }

    const actionsArray = Array.from(pendingActions.values());
    document.getElementById('batchActions').value = JSON.stringify(actionsArray);
  });

  function formatBytesJS(bytes) {
    if (bytes < 1024) {
      return bytes + 'B';
    }
    if (bytes < 1048576) {
      return Math.round(bytes / 1024) + 'KB';
    }
    return (bytes / 1048576).toFixed(1) + 'MB';
  }

  document.getElementById('uploadForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const fileInput = document.getElementById('fileInput');
    if (!fileInput.files.length) {
      return;
    }

    const file = fileInput.files[0];
    const formData = new FormData();
    formData.append('archive', file, file.name);

    const submitBtn = document.getElementById('submitBtn');
    const progress = document.getElementById('uploadProgress');
    const progressBar = document.getElementById('progressBar');
    const progressText = document.getElementById('progressText');

    submitBtn.disabled = true;
    progress.classList.add('active');
    progressBar.classList.remove('indeterminate');
    progressBar.style.width = '0%';

    const xhr = new XMLHttpRequest();

    xhr.upload.addEventListener('progress', function(evt) {
      if (evt.lengthComputable) {
        const percent = Math.round((evt.loaded / evt.total) * 100);
        progressBar.style.width = percent + '%';
        progressText.textContent = percent + '% — ' + formatBytesJS(evt.loaded) + ' / ' + formatBytesJS(evt.total);
      }
    });

    xhr.upload.addEventListener('load', function() {
      progressBar.classList.add('indeterminate');
      progressText.textContent = 'Décompression en cours...';
    });

    xhr.onload = function() {
      document.open();
      document.write(xhr.responseText);
      document.close();
    };

    xhr.onerror = function() {
      progress.classList.remove('active');
      submitBtn.disabled = false;
      progressText.textContent = '';
      alert("Erreur réseau pendant l'envoi.");
    };

    xhr.open('POST', window.location.pathname + window.location.search, true);
    xhr.send(formData);
  });
  </script>
</body>
</html>